# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
SALONOS_DASHBOARD_ORIGIN=http://localhost:8091

# Supabase (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Postgres (Supabase → Database → Connection string)
# DATABASE_URL = pooled (Transaction / port 6543) for runtime
# DIRECT_URL  = direct (Session / port 5432) for Prisma migrations
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.YOUR_PROJECT:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Stripe Connect
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Platform application fee percent (default 15)
COMMISSION_PERCENT=15

# Google Maps (placeholder)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your-google-maps-key

# OpenRouter (SalonOS AI — Return Engine / Slot Filler insights)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=sk-or-v1-xxx

# Email (Resend — without key, emails are console.logged)
RESEND_API_KEY=re_xxx
RESEND_FROM=ServisHub SK <noreply@servishub.sk>

# Sentry (optional — bez DSN je monitoring vypnutý; vyžaduje pnpm add @sentry/nextjs)
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# E2E / seed demo users (do not commit real passwords in git)
E2E_PROVIDER_EMAIL=e2e-provider@example.com
E2E_PROVIDER_PASSWORD=change-me-provider
E2E_CUSTOMER_EMAIL=e2e-customer@example.com
E2E_CUSTOMER_PASSWORD=change-me-customer

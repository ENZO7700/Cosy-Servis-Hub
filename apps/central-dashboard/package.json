{
  "name": "centralny-dashboard-e2e",
  "private": true,
  "version": "1.0.0",
  "description": "Playwright integrity / e2e tests for Centralny Dashboard",
  "scripts": {
    "test:e2e": "playwright test",
    "test:integrity": "playwright test --project=integrity",
    "test:integrity:headed": "playwright test --project=integrity --headed",
    "test:iphone-air": "playwright test --project=iphone-17-air-premium",
    "test:iphone-air:headed": "playwright test --project=iphone-17-air-premium --headed",
    "test:iphone-air:webkit": "playwright test --project=iphone-17-air-premium-webkit",
    "test:iphone-air:report": "playwright show-report && echo 'Also see e2e/artifacts/iphone-17-air-premium-report.md'",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "playwright:install": "playwright install --with-deps chromium",
    "playwright:install:all": "playwright install --with-deps"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@types/node": "^22.17.0",
    "typescript": "^5.9.2"
  }
}

# =============================================================================
# Cozy AI Studio — production environment
# Copy to Vercel → Environment Variables (Production)
# Full secrets only in .env.production.local (never commit)
# =============================================================================

# --- Auth provider ---
# auto | supabase | better-auth
# auto = Supabase if SUPABASE_URL+keys set, else Better Auth
AUTH_PROVIDER=auto
VITE_AUTH_PROVIDER=auto
VITE_AUTH_ENABLED=true

# --- Path A: Supabase Auth + DB ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only — never VITE_* / never client bundle
SUPABASE_SERVICE_ROLE_KEY=
# New dashboard names (aliases of anon / service_role)
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
# SUPABASE_JWKS_URL=https://YOUR_REF.supabase.co/auth/v1/.well-known/jwks.json
# Public mirrors for browser client (same values as above public ones)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Alias from Supabase quickstart (publishable key) — same as ANON_KEY
# VITE_SUPABASE_KEY=
# VITE_SUPABASE_PUBLISHABLE_KEY=

# Postgres connection (Supabase pooler URI or Neon)
DATABASE_URL=

# --- Path B: Better Auth (Grok broker / email) ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# GROK_AUTH_ISSUER=
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=

# --- AI ---
MISTRAL_API_KEY=
DEMO_PIPELINE=false

# --- Stripe (MUST DO) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
# STRIPE_PUBLISHABLE_KEY=

# --- Vercel launch ---
VERCEL_TOKEN=
VERCEL_TEAM_ID=
# VERCEL_PROJECT_ID=
# VERCEL_DEPLOY_HOOK_URL=

# --- WordPress / CCT (server-only — never VITE_) ---
# Local sandbox: http://localhost:4422 + App Password from local-wp/CREDENTIALS.local.md
# Studio defaults to http://127.0.0.1:8090 (8080 often taken by another COSY.AI app)
WP_BASE_URL=http://localhost:4422
WP_USERNAME=admin
WP_APP_PASSWORD=
# Empty or "local-cct-mirror" → mirror inventory (no live writes)
# WP_CCT_MIRROR=false
